<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="551.0" prefWidth="609.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.senac.sp.pizzaria.controller.PizzaController">

    <Label layoutX="14.0" layoutY="17.0" text="ID:">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TextField fx:id="tfId" editable="false" layoutX="44.0" layoutY="12.0" prefHeight="30.0" prefWidth="45.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <Label layoutX="100.0" layoutY="17.0" text="Sabor:">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TextField fx:id="tfSabor" layoutX="153.0" layoutY="12.0" prefHeight="30.0" prefWidth="445.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <Label layoutX="12.0" layoutY="54.0" text="Tipo:">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <ComboBox fx:id="cbTipo" layoutX="58.0" layoutY="54.0" prefHeight="25.0" prefWidth="168.0" />

    <Label layoutX="234.0" layoutY="55.0" text="Tamanho:">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <ComboBox fx:id="cbTamanho" layoutX="309.0" layoutY="53.0" prefWidth="150.0" />


    <Label layoutX="471.0" layoutY="56.0" text="Preço:">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TextField fx:id="tfPreco" layoutX="521.0" layoutY="51.0" prefHeight="30.0" prefWidth="76.0">
        <font>
            <Font size="14.0" />
        </font>
    </TextField>

    <Label layoutX="12.0" layoutY="88.0" text="Ingr.:">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>


    <Button layoutX="15.0" layoutY="172.0" mnemonicParsing="false" onAction="#salvar" prefHeight="40.0" prefWidth="40.0">
        <graphic>
            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../icones/iconesalvar.png" />
            </ImageView>
        </graphic>
    </Button>
    <Button layoutX="75.0" layoutY="172.0" mnemonicParsing="false" onAction="#excluir" prefHeight="40.0" prefWidth="40.0">
        <graphic>
            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../icones/iconexcluir.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>
    <Button layoutX="134.0" layoutY="172.0" mnemonicParsing="false" onAction="#limpar" prefHeight="48.0" prefWidth="56.0">
        <graphic>
            <ImageView fitHeight="37.0" fitWidth="89.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../icones/iconelimpar.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button layoutX="193.0" layoutY="172.0" mnemonicParsing="false" onAction="#buscar" prefHeight="48.0" prefWidth="53.0">
        <graphic>
            <ImageView fitHeight="47.0" fitWidth="37.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../icones/iconebuscar.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>
    <TextArea fx:id="taIngredientes" layoutX="58.0" layoutY="90.0" prefHeight="73.0" prefWidth="535.0" />
    <TableView fx:id="tbPizza" layoutX="14.0" layoutY="235.0" prefHeight="305.0" prefWidth="580.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
            <TableColumn fx:id="colSabor" prefWidth="353.0" text="Sabor" />
            <TableColumn fx:id="colTamanho" prefWidth="151.0" text="Tamanho" />
        </columns>
    </TableView>


</AnchorPane>
