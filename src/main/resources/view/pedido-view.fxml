<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="497.0" prefWidth="665.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.senac.sp.pizzaria.controller.PedidoController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Telefone:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
      <TextField fx:id="tfTelefone" alignment="CENTER" layoutX="84.0" layoutY="9.0" onAction="#buscarCliente" prefHeight="30.0" prefWidth="138.0" promptText="Enter p/ buscar">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <Label layoutX="229.0" layoutY="14.0" text="Cliente:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="tfCliente" alignment="CENTER" editable="false" layoutX="287.0" layoutY="9.0" prefHeight="30.0" prefWidth="372.0">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <Label layoutX="14.0" layoutY="50.0" text="Endereço:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="tfEndereco" alignment="CENTER" editable="false" layoutX="84.0" layoutY="46.0" prefHeight="30.0" prefWidth="575.0">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <TextField fx:id="tfIngredientes" alignment="CENTER" layoutX="13.0" layoutY="90.0" onAction="#buscarPizza" prefHeight="30.0" prefWidth="266.0" promptText="Ingredientes p/ buscar">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <ListView fx:id="lstPizza" layoutX="13.0" layoutY="131.0" prefHeight="289.0" prefWidth="266.0" />
      <ListView fx:id="lstItem" layoutX="389.0" layoutY="131.0" prefHeight="289.0" prefWidth="266.0" />
      <Button fx:id="btAdd" layoutX="318.0" layoutY="235.0" mnemonicParsing="false" onAction="#addItem" prefHeight="30.0" prefWidth="33.0" text="&gt;&gt;" />
      <Button fx:id="btRemove" layoutX="318.0" layoutY="280.0" mnemonicParsing="false" onAction="#removeItem" prefHeight="30.0" prefWidth="33.0" text="&lt;&lt;" />
      <Spinner fx:id="spQtd" editable="true" layoutX="302.0" layoutY="189.0" prefHeight="30.0" prefWidth="65.0" />
      <Label fx:id="lbTotal" layoutX="608.0" layoutY="96.0" text="R$ 0,00">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbFormaPagamento" layoutX="389.0" layoutY="94.0" prefHeight="25.0" prefWidth="197.0" promptText="Forma de pagamento" />
      <Button fx:id="btPedido" layoutX="591.0" layoutY="429.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="62.0">
         <graphic>
            <ImageView fitHeight="62.0" fitWidth="46.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../icones/iconepedido.png" />
            </ImageView>
         </graphic>
      </Button>
   </children>
</AnchorPane>
